---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import { withBase } from "@/utils/url";

const homeUrl = withBase();
---
<BaseLayout title="页面不存在 - Luxirty Search" robots="noindex, follow">
  <div class="page">
    <main class="not-found">
      <p class="code">404</p>
      <h1>页面不存在</h1>
      <p>你访问的页面可能已被移动或删除。</p>
      <p><a class="home-link" href={homeUrl}>返回首页</a></p>
    </main>
    <Footer variant="results" />
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .not-found {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    box-sizing: border-box;
  }

  .code {
    font-size: 72px;
    font-weight: bold;
    line-height: 1;
    color: var(--uv-styles-color-text-de-emphasis);
  }

  h1 {
    margin: 16px 0;
    font-size: 28px;
  }

  p {
    margin: 6px 0;
    color: var(--uv-styles-color-text-default);
  }

  .home-link {
    display: inline-block;
    margin-top: 16px;
    padding: 10px 24px;
    color: #fff;
    background: var(--uv-styles-color-primary);
    border-radius: 26px;
  }
</style>
