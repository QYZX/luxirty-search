---
import { withBase } from "@/utils/url";

const homeUrl = withBase();
---
<div class="my-container">
  <div class="search-container" id="searchContainer">
    <h1 class="search-title"><a href={homeUrl}>Luxirty Search</a></h1>
    <div class="gcse-searchbox"></div>
  </div>
  <div class="search-result-zone">
    <div class="gcse-searchresults" data-linkTarget="_blank" data-refinementStyle="link"></div>
    <noscript>
      <p class="noscript-tip">
        Luxirty Search 的搜索结果需要 JavaScript。请启用 JavaScript，或
        <a href={homeUrl}>返回首页</a>。
      </p>
    </noscript>
  </div>

  <!-- 页脚由调用方传入，保持 flex 布局中结果区占满剩余高度 -->
  <slot />
</div>

<style>
  .my-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    max-width: var(--center-width);
    min-width: 320px;
    box-sizing: border-box;
  }

  .search-container {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
    margin-top: 26px;
    margin-left: 28px;
    min-height: 48px;
  }

  .search-title {
    font-size: 24px;
    color: #58636f;
    margin-right: 20px;
    white-space: nowrap;
    user-select: none;
  }

  .search-title a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .search-container {
      flex-direction: column;
      align-items: center;
      margin-bottom: 10px;
      margin-top: 10px;
      margin-left: 0px;
      min-height: 48px;
      width: 100vw;
    }

    .search-title {
      font-size: 20px;
      margin-bottom: 10px;
      margin-right: 0;
    }
  }

  @media (prefers-color-scheme: dark) {
    .search-title {
      color: #d1d5db;
    }
  }

  .search-result-zone {
    flex-grow: 1;
  }

  .noscript-tip {
    margin: 20px 28px;
    color: var(--uv-styles-color-text-default);
  }
</style>
